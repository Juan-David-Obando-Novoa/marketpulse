# ---------------------------------------------------------------------------
# MarketPulse local environment
#
# Copy to .env before running `make up`. Every value here is a LOCAL DEVELOPMENT
# credential and is deliberately committed as an example -- .env itself is
# gitignored, and a real deployment injects these from a secret store.
#
# Naming follows pydantic-settings' nested delimiter: MP_<SECTION>__<FIELD>.
# ---------------------------------------------------------------------------

MP_ENVIRONMENT=local
MP_SERVICE_NAME=marketpulse

# --- Kafka / Redpanda ------------------------------------------------------
# 19092 is the host-facing listener; inside the compose network use redpanda:9092.
MP_KAFKA__BOOTSTRAP_SERVERS=localhost:19092
MP_KAFKA__SCHEMA_REGISTRY_URL=http://localhost:18081
MP_KAFKA__CLIENT_ID=marketpulse-producer
MP_KAFKA__COMPRESSION_TYPE=zstd
MP_KAFKA__LINGER_MS=50

# --- Object storage (MinIO) ------------------------------------------------
MP_S3__ENDPOINT=http://localhost:9000
MP_S3__ACCESS_KEY=minioadmin
MP_S3__SECRET_KEY=minioadmin
MP_S3__BUCKET=lakehouse
MP_S3__REGION=us-east-1

# --- Iceberg REST catalog --------------------------------------------------
MP_ICEBERG__REST_URI=http://localhost:8181
MP_ICEBERG__CATALOG_NAME=lakehouse
MP_ICEBERG__SNAPSHOT_RETENTION_DAYS=7

# --- Upstream feed ---------------------------------------------------------
# data-*.binance.vision is the public read-only market-data mirror: no API key,
# no trading endpoints, and no geographic restrictions to work around.
MP_BINANCE__WS_BASE_URL=wss://data-stream.binance.vision/stream
MP_BINANCE__REST_BASE_URL=https://data-api.binance.vision
MP_BINANCE__SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","XRPUSDT","ADAUSDT"]
MP_BINANCE__STREAMS=["trade","bookTicker"]
MP_BINANCE__IDLE_TIMEOUT_SECONDS=30

# --- Reference FX (Banco de la Republica TRM via datos.gov.co) -------------
# Optional. Anonymous access works but is throttled; a free app token is not a
# secret in the credential sense but is still handled as one.
# MP_FX__APP_TOKEN=

# --- Observability ---------------------------------------------------------
MP_OBSERVABILITY__METRICS_PORT=9108
MP_OBSERVABILITY__LOG_LEVEL=INFO
MP_OBSERVABILITY__JSON_LOGS=true

# --- Infrastructure credentials (consumed by docker-compose, not the app) --
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=marketpulse
POSTGRES_DB=marketpulse
GRAFANA_ADMIN_PASSWORD=admin
